{if $message}
    <div n:foreach="$message as $error" id="error-block">{$error}</div>
{/if}

<div class="dash-column">
    <div class="dash-header">{$id ? "Edit Task" : "Add Task"}</div>
    <div class="dash-content">
        <form id="input-form" method="post" action="save-task.php">
            <input type="hidden" value={$id} name="id">
            <div class="label-cell"><label for="desc">Description:</label></div>
            <div class="input-cell"><textarea name="description" id="desc">{$description ?? ''}</textarea></div>
            <div class="label-cell">Estimate:</div>
            <div class="input-cell">
                {foreach range(1, 5) as $nr}
                    <label>
                        <input type="radio"
                               name="estimate"
                               value="{$nr}"
                               n:attr="checked: !empty($estimate) && $estimate == $nr"
                        > {$nr}
                    </label>
                {/foreach}
            </div>
            <div class="label-cell">Assigned to:</div>
            <div class="input-cell">
                <select id="employee" name="employeeId">
                    <option value=""></option>
                    {var $employees = $repository->getEmployees()}
                    <option n:foreach="$employees as $employee" n:attr="selected => isset($employeeID) && $employeeID == $employee->id"  value="{$employee->id}">{$employee->firstName} {$employee->lastName}</option>
                </select>
            </div>
            <div n:if="$id" class="label-cell"><label for="isCompleted">Completed:</label></div>
            <div n:if="$id" class="input-cell"><input id="isCompleted" type="checkbox" n:attr="checked => $isCompleted" name="isCompleted" /></div>
            <div class="label-cell"></div>
            <div class="input-cell"> <br> <button name="submitButton" type="submit" formaction="?cmd=task-save">Save</button></div>
            <div n:if="$id" class="label-cell"></div>
            <div n:if="$id" class="input-cell"> <br> <button name="deleteButton" type="submit" formaction="?cmd=task-delete">Delete</button></div>
        </form>
    </div>
</div>